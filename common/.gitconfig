[user]
  email = pmav99@gmail.com
  name = Panos Mavrogiorgos
[push]
  default = simple
[diff]
  algorithm = patience
  tool = gvimdiff
  colormoved = default
[color]
  diff = auto
  status = auto
  branch = auto
	ui = true
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
	meta = 11
	frag = magenta bold
	old = red bold
	new = green bold
	func = 146 bold
	commit = yellow bold
	whitespace = red reverse
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[core]
  autocrlf = input
  editor = vim
  pager = ,pager
[delta]
  navigate = true
  light = false
  side-by-side = true
  line-numbers = true
[grep]
  linenumber = true
[github]
  user = pmav99
[gitlab]
  user = pmav99
[bitbucket]
  user = pmav99
[apply]
  whitespace = nowarn
[pull]
  rebase = true
[include]
  path = ~/.gitconfig.ssh
[mergetool]
  prompt = false
[merge]
	conflictStyle = zdiff3
[alias]
  lg1 = log --exclude gh-pages --all --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'
  lg2 = log --exclude gh-pages --all --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'
  f = fetch --all
[gui]
	fontdiff = -family \"saucecodepro nfm\" -size 10 -weight normal -slant roman -underline 0 -overstrike 0
	fontui = -family \"Noto Sans\" -size 8 -weight normal -slant roman -underline 0 -overstrike 0
[credential]
  helper = cache --timeout 57600
[gpg]
  program = gpg2
[init]
	defaultBranch = master
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[interactive]
  diffFilter = delta --color-only --features=interactive
[status]
	short = true
	branch = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
