#
# Executes commands at the start of an interactive session.
#
# Authors:
#   Sorin Ionescu <sorin.ionescu@gmail.com>
#
#
echo zshrc.local

# Setup PATH
# https://superuser.com/a/598924/258915
typeset -U path
path=($HOME/.local/my_bin
      $HOME/.local/bin
      $path)
export PATH

# disable AUTO_CD
unsetopt AUTO_CD

# common aliases
source ~/.shell_common


# direnv
if [ $commands[direnv] ]; then
    eval "$(direnv hook zsh)"
fi

# fzf
if [ $commands[fzf] ]; then
  # The common configuration is in .shell_common
  # Here we have just the zsh specific stuff
  # key bindings
  if [ -f /usr/share/fzf/key-bindings.zsh ]; then
    source /usr/share/fzf/key-bindings.zsh
    source /usr/share/fzf/completion.zsh
  elif [ -f "${HOME}"/.fzf/shell/key-bindings.zsh ]; then
    source "${HOME}"/.fzf/shell/key-bindings.zsh
    source "${HOME}"/.fzf/shell/completion.zsh
  else
    echo "couldn't find fzf key-bindings"
  fi
fi

# zsh-only aliases
alias ls="${aliases[ls]:-ls} -v"    # XXX ZSH ONLY!!! Make ls use natural sort
alias mmv='noglob zmv -W'

update_awesome_menu() {
    if [ $commands[xdg_menu] ]; then
        rm -rf ~/.config/awesome/archmenu.lua
        xdg_menu --format awesome --root-menu /etc/xdg/menus/arch-applications.menu > ~/.config/awesome/archmenu.lua
    else
        echo "Please install xdg-menu (archlinux-xdg-menu)."
    fi
}

# Prompt (keep Prezto for editing, completion, and other shell features).
if (( $+commands[oh-my-posh] )) && [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-posh/host.sh" ]]; then
    source "${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-posh/host.sh"
    eval "$(oh-my-posh init zsh --config "${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-posh/prompt.omp.json")"
fi
